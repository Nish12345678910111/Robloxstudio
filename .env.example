# NishCloudPhone - Vercel Environment Variables (Project > Settings > Environment Variables)
# Your Aiven Postgres connection string (from Aiven console > Service > Connection information)
AIVEN_DATABASE_URL=postgres://avnadmin:PASSWORD@YOURHOST.aivencloud.com:PORT/defaultdb?sslmode=require
# Signs login sessions (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Seeds the admin account on first use:  username = admin
ADMIN_PASSWORD=
# GitHub fine-grained PAT (this repo only, Actions: Read and write) - server-side only, never in code
GITHUB_TOKEN=
# Optional but recommended: three fallback keys - if the key above hits its
# limit, the app automatically switches to these (same kind of token)
GITHUB_TOKEN_FALLBACK_1=
GITHUB_TOKEN_FALLBACK_2=
GITHUB_TOKEN_FALLBACK_3=
GITHUB_OWNER=Nish12345678910111
GITHUB_REPO=Robloxstudio
