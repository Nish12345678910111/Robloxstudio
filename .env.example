# Cloudflare Pages Functions variables and secrets (Production + Preview).
# Store these in the Cloudflare dashboard; never commit real values.
AIVEN_DATABASE_URL=postgres://avnadmin:PASSWORD@YOURHOST.aivencloud.com:PORT/defaultdb?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-the-admin-password
GITHUB_TOKEN=
GITHUB_TOKEN_FALLBACK_1=
GITHUB_TOKEN_FALLBACK_2=
GITHUB_TOKEN_FALLBACK_3=
GITHUB_OWNER=Nish12345678910111
GITHUB_REPO=Robloxstudio
GITHUB_WORKFLOW=cloud-phone.yml
GITHUB_API_BASE=https://api.github.com

# AIVEN_DATABASE_URL must be added as an encrypted Pages Function secret.
# The GitHub Actions runner also needs the same AIVEN_DATABASE_URL value as a
# repository secret so it can save phone connection details. Do not commit it.
