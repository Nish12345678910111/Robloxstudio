{
  "name": "nishcloudphone",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run start",
    "build": "vite build --config cloudflare-pages/vite.config.mjs",
    "start": "npm run build && wrangler pages dev cloudflare-pages-dist --ip 0.0.0.0",
    "pages:build": "npm run build",
    "pages:dev": "npm run start"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
