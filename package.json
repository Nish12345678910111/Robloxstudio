{
  "name": "nishcloudphone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run start",
    "build": "vite build --config cloudflare-pages/vite.config.mjs",
    "test": "node --test",
    "vercel:build": "next build",
    "start": "npm run build && wrangler pages dev cloudflare-pages-dist --ip 0.0.0.0 --compatibility-date=2026-11-07 --compatibility-flag=nodejs_compat",
    "pages:build": "npm run build",
    "pages:dev": "npm run start"
  },
  "dependencies": {
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
